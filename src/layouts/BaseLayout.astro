---
import '../styles/global.css';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  fullScreen?: boolean;
  /** Immersive pages (e.g. the simulation) hide the navbar on mobile and lock
   *  page zoom so the canvas owns the whole screen. */
  immersive?: boolean;
}

const { title, description = 'Modelica as a Universal Symbolic Frontend. Open source. Written in Rust. Runs in your browser.', fullScreen = false, immersive = false } = Astro.props;

// Immersive pages disable page-level pinch-zoom (the sim handles its own) and
// extend under the notch/home indicator via viewport-fit=cover.
const viewport = immersive
  ? 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover'
  : 'width=device-width, initial-scale=1.0, viewport-fit=cover';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/images/rumoca.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0c0f12" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="/images/rumoca.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline src="/coi-serviceworker.js"></script>
  </head>
  <body class={fullScreen ? 'flex flex-col h-dvh overflow-hidden' : ''}>
    {immersive
      ? <div class="hidden md:contents"><Navbar /></div>
      : <Navbar />}
    <main class={fullScreen ? 'flex-1 overflow-hidden' : ''}>
      <slot />
    </main>
    {!fullScreen && <Footer />}
  </body>
</html>
